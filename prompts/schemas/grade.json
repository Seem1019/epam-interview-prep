{
  "type": "object",
  "additionalProperties": false,
  "required": ["score", "verdict", "level_demonstrated", "justification_es", "missing_points_es", "concision", "model_answer_en"],
  "properties": {
    "score": { "type": "integer", "description": "0-100" },
    "verdict": { "type": "string", "enum": ["correct", "partial", "incorrect"] },
    "level_demonstrated": { "type": "string", "enum": ["None", "Novice", "Intermediate", "Advanced", "Expert"] },
    "justification_es": { "type": "string" },
    "missing_points_es": { "type": "array", "items": { "type": "string" } },
    "concision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "comment_es", "short_version_en"],
      "properties": {
        "verdict": { "type": "string", "enum": ["concise", "acceptable", "too_long", "too_short"] },
        "comment_es": { "type": "string" },
        "short_version_en": { "type": "string" }
      }
    },
    "model_answer_en": { "type": "string" }
  }
}
